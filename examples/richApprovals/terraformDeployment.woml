<woml>
  <workflow id="reviewed-terraform-deployment" name="Reviewed Terraform deployment" description="Creates, preserves, reviews, and applies one exact Terraform plan." version="1.0.0">
    <triggers><manual id="start" /></triggers>
    <steps>
      <step id="plan" name="Create the Terraform plan">
        <script>
          return await services.process.run({
            executable: "terraform",
            args: ["plan", "-out", ".woml/artifact-input/production.tfplan", "-no-color"],
            timeout: "10m",
            output: { stdout: "capture", stderr: "capture", maxBytes: 65536 }
          }, { name: "terraform-plan" });
        </script>
      </step>

      <step id="evidence" name="Preserve the exact reviewed plan">
        <script>
          const artifact = await services.artifacts.put(
            ".woml/artifact-input/production.tfplan",
            { name: "production.tfplan", contentType: "application/octet-stream", retention: "30d" }
          );
          return {
            review: {
              title: "Apply the production Terraform plan",
              summary: "Apply the immutable plan produced by the successful planning step.",
              risk: "high",
              facts: [
                { label: "Environment", value: "production" },
                { label: "Terraform exit code", value: String(context.steps.plan.exitCode) }
              ],
              changes: [
                { action: "update", target: "production infrastructure", summary: "Apply the attached Terraform plan without recalculating it." }
              ],
              checks: [
                { name: "terraform plan", status: context.steps.plan.exitCode === 0 ? "passed" : "failed" }
              ],
              artifacts: [artifact]
            },
            artifact
          };
        </script>
      </step>

      <approval id="approvePlan" name="Approve production plan" description="A production owner and security owner must approve the same immutable plan." review="{{context.steps.evidence.review}}" approvals="2" required-roles="production-owner security-owner" timeout="24h" on-timeout="reject">
        <when-approved>
          <step id="apply" name="Apply the reviewed plan">
            <script>
              const path = await services.artifacts.materialize(context.steps.evidence.artifact);
              return await services.process.run({
                executable: "terraform",
                args: ["apply", "-auto-approve", path],
                timeout: "20m",
                output: { stdout: "capture", stderr: "capture", maxBytes: 65536 }
              }, { name: "terraform-apply" });
            </script>
          </step>
        </when-approved>
        <when-rejected>
          <step id="declined"><script>return { applied: false, reason: "review-rejected" };</script></step>
        </when-rejected>
      </approval>

      <step id="result"><script>return context.steps.approvePlan;</script></step>
    </steps>
  </workflow>
</woml>
