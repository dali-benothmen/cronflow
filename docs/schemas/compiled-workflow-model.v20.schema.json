{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/compiled-workflow-model/v20",
  "title": "WOML Rich Plan Approval Compiled Workflow Model v20",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowId", "triggers", "graph", "runtimePolicy"],
  "properties": {
    "schemaVersion": { "const": 20 },
    "workflowId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "metadata": { "type": "object" },
    "triggers": { "type": "array" },
    "runtimePolicy": { "type": "object" },
    "moduleRuntime": { "type": "object" },
    "lifecycle": { "type": "object" },
    "reusableDefinitions": { "type": "array" },
    "communication": { "type": "object" },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["entryNodeIds", "nodes", "edges", "forks", "choices", "contextVisibility", "settlement", "forEach", "waits", "locks", "sagas"],
      "properties": {
        "entryNodeIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "nodes": {
          "type": "array",
          "contains": {
            "type": "object", "additionalProperties": true,
            "required": ["id", "handler", "inputs"],
            "properties": {
              "handler": { "const": "engine.approval-wait" },
              "inputs": {
                "type": "object", "required": ["kind", "fields"],
                "properties": {
                  "kind": { "const": "object" },
                  "fields": {
                    "type": "object", "required": ["review", "requiredApprovals", "requiredRoles"],
                    "properties": {
                      "review": { "$ref": "#/$defs/contextReference" },
                      "requiredApprovals": { "$ref": "#/$defs/approvalCount" },
                      "requiredRoles": { "$ref": "#/$defs/roles" }
                    }
                  }
                }
              }
            }
          }
        },
        "edges": { "type": "array" }, "forks": { "type": "array" }, "choices": { "type": "array" },
        "contextVisibility": { "type": "array" }, "settlement": { "type": "object" }, "forEach": { "type": "array" },
        "waits": { "type": "array" }, "locks": { "type": "array" }, "sagas": { "type": "array" }
      }
    }
  },
  "$defs": {
    "contextReference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "path"],
      "properties": { "kind": { "const": "contextReference" }, "path": { "type": "array", "minItems": 2, "items": { "type": "string" }, "prefixItems": [{ "const": "steps" }, { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }] } }
    },
    "approvalCount": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "type": "integer", "minimum": 1, "maximum": 20 } } },
    "roles": { "type": "object", "additionalProperties": false, "required": ["kind", "items"], "properties": { "kind": { "const": "array" }, "items": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "literal" }, "value": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$", "maxLength": 64 } } } } } }
  }
}
