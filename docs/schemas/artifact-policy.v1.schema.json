{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woml.dev/schemas/artifact-policy/v1",
  "title": "WOML Artifact Policy v1",
  "description": "Runtime-owned least-authority policy for durable artifacts. Workflow code cannot modify this document.",
  "x-status": "durable-artifacts-da1-frozen",
  "x-defaults": {
    "maxArtifactBytes": 1073741824,
    "maxRunBytes": 10737418240,
    "maxStoreBytes": 107374182400,
    "maxConcurrentTransfers": 4,
    "transferTimeoutMs": 3600000,
    "defaultRetentionMs": 2592000000,
    "minimumRetentionMs": 3600000,
    "maximumRetentionMs": 31536000000,
    "knownSecretAction": "reject"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "contractVersion", "enabled", "modes", "projectRoot", "readRoots", "materialization", "limits", "retention", "secretScanning", "backend"],
  "properties": {
    "contract": { "const": "woml.artifact-policy" },
    "contractVersion": { "const": 1 },
    "enabled": { "type": "boolean" },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "background"],
      "properties": {
        "foreground": { "type": "boolean" },
        "background": { "type": "boolean" }
      }
    },
    "projectRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "readRoots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "cleanupOnStart", "maxBytesPerAttempt"],
      "properties": {
        "directory": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "cleanupOnStart": { "const": true },
        "maxBytesPerAttempt": { "type": "integer", "minimum": 1, "maximum": 4398046511104 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxArtifactBytes", "maxRunBytes", "maxStoreBytes", "maxConcurrentTransfers", "transferTimeoutMs"],
      "properties": {
        "maxArtifactBytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
        "maxRunBytes": { "type": "integer", "minimum": 1, "maximum": 4398046511104 },
        "maxStoreBytes": { "type": "integer", "minimum": 1, "maximum": 1125899906842624 },
        "maxConcurrentTransfers": { "type": "integer", "minimum": 1, "maximum": 64 },
        "transferTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMs", "minimumMs", "maximumMs"],
      "properties": {
        "defaultMs": { "type": "integer", "minimum": 3600000, "maximum": 31536000000 },
        "minimumMs": { "type": "integer", "minimum": 3600000, "maximum": 31536000000 },
        "maximumMs": { "type": "integer", "minimum": 3600000, "maximum": 31536000000 }
      }
    },
    "secretScanning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knownSecretAction", "minimumSecretBytes"],
      "properties": {
        "knownSecretAction": { "enum": ["reject", "quarantine", "allow"] },
        "minimumSecretBytes": { "const": 8 }
      }
    },
    "backend": { "$ref": "https://woml.dev/schemas/artifact-backend/v1" }
  }
}
