{
  "contract": "woml.artifact-policy",
  "contractVersion": 1,
  "enabled": true,
  "modes": {
    "foreground": true,
    "background": true
  },
  "projectRoot": "../..",
  "readRoots": ["."],
  "materialization": {
    "directory": ".woml/materialized-v1",
    "cleanupOnStart": true,
    "maxBytesPerAttempt": 2147483648
  },
  "limits": {
    "maxArtifactBytes": 1073741824,
    "maxRunBytes": 10737418240,
    "maxStoreBytes": 107374182400,
    "maxConcurrentTransfers": 2,
    "transferTimeoutMs": 3600000
  },
  "retention": {
    "defaultMs": 2592000000,
    "minimumMs": 3600000,
    "maximumMs": 31536000000
  },
  "secretScanning": {
    "knownSecretAction": "reject",
    "minimumSecretBytes": 8
  },
  "backend": {
    "contract": "woml.artifact-backend",
    "contractVersion": 1,
    "kind": "local",
    "directory": ".woml/artifacts-v1"
  }
}
