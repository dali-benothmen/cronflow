<woml>
  <workflow id="credential-rotation" name="Serialized credential rotation" description="Rotate one account credential without racing another run." version="1.0.0">
    <triggers><manual id="start" /></triggers>
    <steps>
      <step id="target" name="Select account"><script>return { provider: "internal-registry", account: "release-bot" };</script></step>
      <lock id="rotation" name="Own credential rotation" key="credentials/{{context.steps.target.provider}}/{{context.steps.target.account}}" acquire-timeout="10m" lease="30s">
        <step id="rotate" name="Rotate credential">
          <script>
            const response = await services.http.request({ method: "POST", url: "https://identity.example.test/v1/credentials/rotate", headers: { authorization: `Bearer ${secrets.IDENTITY_TOKEN}` }, body: { account: context.steps.target.account, fencingToken: context.lock.fencingToken } }, { name: "rotate-registry-credential", idempotencyKey: context.lock.fencingToken });
            return { accepted: response.ok, fencingToken: context.lock.fencingToken };
          </script>
        </step>
      </lock>
      <step id="result" name="Return rotation result"><script>return context.steps.rotation;</script></step>
    </steps>
  </workflow>
</woml>
