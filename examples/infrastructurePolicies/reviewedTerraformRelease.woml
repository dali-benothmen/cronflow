<woml>
  <workflow id="reviewed-terraform-release" name="Reviewed Terraform release" description="Plan, review, serialize, apply, verify, and compensate a production infrastructure change." version="1.0.0">
    <triggers>
      <manual id="start" />
    </triggers>

    <steps>
      <step id="createPlan" name="Create Terraform plan">
        <script>
          return await services.process.run({
            executable: "terraform",
            args: ["plan", "-out", ".woml/artifact-input/production.tfplan", "-no-color"],
            timeout: "10m",
            output: { stdout: "capture", stderr: "capture", maxBytes: 65536 }
          }, { name: "terraform-plan" });
        </script>
      </step>

      <step id="buildReview" name="Preserve exact forward and recovery plans">
        <script>
          const forwardPlan = await services.artifacts.put(
            ".woml/artifact-input/production.tfplan",
            { name: "production.tfplan", contentType: "application/octet-stream", retention: "30d" }
          );
          const recoveryPlan = await services.artifacts.put(
            context.payload.recoveryPlanPath ?? ".woml/artifact-input/recovery.tfplan",
            { name: "recovery.tfplan", contentType: "application/octet-stream", retention: "30d" }
          );
          return {
            forwardPlan,
            recoveryPlan,
            review: {
              title: "Apply production Terraform plan",
              summary: "Apply the exact generated plan while retaining an independently prepared recovery plan.",
              risk: "high",
              facts: [{ label: "Environment", value: "production" }],
              changes: [{ action: "update", target: "production infrastructure", summary: "Apply the attached immutable plan." }],
              checks: [{ name: "terraform plan", status: context.steps.createPlan.exitCode === 0 ? "passed" : "failed" }],
              artifacts: [forwardPlan, recoveryPlan]
            }
          };
        </script>
      </step>

      <approval id="approveRelease" name="Approve production release" description="Two different trusted owners approve the exact plan and recovery artifact." review="{{context.steps.buildReview.review}}" approvals="2" required-roles="production-owner security-owner" timeout="1h" on-timeout="reject">
        <when-approved>
          <lock id="deploymentLease" name="Own production deployment lease" key="production/terraform" acquire-timeout="15m" lease="5m">
            <saga id="applyAndVerify" name="Apply and verify reviewed plan">
              <step id="applyPlan" name="Apply reviewed Terraform plan">
                <script>
                  const plan = await services.artifacts.materialize(context.steps.buildReview.forwardPlan);
                  return await services.process.run({
                    executable: "terraform",
                    args: ["apply", "-auto-approve", plan],
                    timeout: "20m",
                    output: { stdout: "capture", stderr: "capture", maxBytes: 65536 }
                  }, { name: "terraform-apply" });
                </script>
                <compensate retry="2">
                  <script>
                    const recovery = await services.artifacts.materialize(context.steps.buildReview.recoveryPlan);
                    return await services.process.run({
                      executable: "terraform",
                      args: ["apply", "-auto-approve", recovery],
                      timeout: "20m",
                      output: { stdout: "capture", stderr: "capture", maxBytes: 65536 }
                    }, { name: "terraform-compensate" });
                  </script>
                </compensate>
              </step>

              <step id="verifyRelease" name="Verify resulting state">
                <script>
                  const verification = await services.process.run({
                    executable: "terraform",
                    args: ["show", "-json"],
                    timeout: "5m",
                    output: { stdout: "capture", stderr: "capture", maxBytes: 65536 }
                  }, { name: "terraform-verify" });
                  if (verification.exitCode !== 0) throw new Error("Terraform verification failed");
                  return { verified: true };
                </script>
              </step>

              <cleanup>
                <step id="recordCleanup" name="Record release finalization">
                  <script>return { finalized: true, fencingToken: context.lock.fencingToken };</script>
                </step>
              </cleanup>
            </saga>
          </lock>
        </when-approved>
        <when-rejected>
          <step id="recordRejection" name="Record rejected release">
            <script>return { applied: false, reason: "review-rejected" };</script>
          </step>
        </when-rejected>
      </approval>

      <step id="summary" name="Publish release outcome">
        <script>return context.steps.approveRelease;</script>
      </step>
    </steps>
  </workflow>
</woml>
